# ============================================================================
# CarPooling - Environment Variables
# ============================================================================
# Copy this file to .env and update values
# DO NOT commit .env to git
# ============================================================================

# MongoDB
MONGO_DB=carpooling
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123

# MySQL
MYSQL_ROOT_PASSWORD=rootpass

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# JWT Secret (use same for all services)
JWT_SECRET=dev-secret-change-in-production

# Application
ENVIRONMENT=development
GIN_MODE=debug
LOG_LEVEL=info

# Mercado Pago (get from https://www.mercadopago.com.ar/developers)
MP_ACCESS_TOKEN=TEST-your-access-token-here
MP_PUBLIC_KEY=TEST-your-public-key-here
MP_CLIENT_ID=your-client-id-here
MP_CLIENT_SECRET=your-client-secret-here
MP_WEBHOOK_SECRET=your-webhook-secret-here

# Payments API Configuration
PLATFORM_FEE_PERCENTAGE=15
AUTO_RELEASE_HOURS=2
ENCRYPTION_KEY=change-this-to-a-32-char-key-prod
